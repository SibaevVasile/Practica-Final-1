<Window x:Class="InventarIT.Views.AtribuireEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atribuire Echipament" Height="502" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">

            <TextBlock Text="Atribuire Echipament"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#2C3E50" Margin="0,0,0,20"/>

            <!-- Angajat -->
            <TextBlock Text="Angajat *" FontSize="13" Margin="0,0,0,4"/>
            <ComboBox x:Name="cmbAngajat" Height="32"
                      FontSize="13" Margin="0,0,0,12"
                      DisplayMemberPath="NumeComplet"
                      SelectedValuePath="IdAngajat"/>

            <!-- Echipament -->
            <TextBlock Text="Echipament (Disponibile) *"
                       FontSize="13" Margin="0,0,0,4"/>
            <ComboBox x:Name="cmbEchipament" Height="32"
                      FontSize="13" Margin="0,0,0,12"
                      DisplayMemberPath="Denumire"
                      SelectedValuePath="IdEchipament"/>

            <!-- Data Atribuire -->
            <TextBlock Text="Data Atribuire"
                       FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="txtDataAtribuire" Height="32"
                     FontSize="13" Padding="6,4"
                     IsReadOnly="True" Background="#F0F0F0"
                     Margin="0,0,0,12"/>

            <!-- Status -->
            <TextBlock Text="Status Atribuire *"
                       FontSize="13" Margin="0,0,0,4"/>
            <ComboBox x:Name="cmbStatus" Height="32"
                      FontSize="13" Margin="0,0,0,12">
                <ComboBoxItem Content="Activa" IsSelected="True"/>
                <ComboBoxItem Content="In asteptare"/>
            </ComboBox>

            <!-- Observatii -->
            <TextBlock Text="Observații"
                       FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="txtObservatii" Height="60"
                     FontSize="13" Padding="6,4"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Margin="0,0,0,25"/>

            <!-- Butoane -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="💾 Salvează"
                        Width="115" Height="36" Margin="0,0,10,0"
                        Background="#27AE60" Foreground="White"
                        FontSize="13" Click="BtnSalveaza_Click"/>
                <Button Content="✖ Anulează"
                        Width="115" Height="36"
                        Background="#95A5A6" Foreground="White"
                        FontSize="13" Click="BtnAnuleaza_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>